# ==============================================================================
# Research Repository - Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env
#
# The .env file is used by docker-compose.yml to supply environment variables
# to the backend service and PostgreSQL database.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# These are used by the `database` service in docker-compose.yml.
POSTGRES_DB=research-repo-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Spring Boot - Core
# ------------------------------------------------------------------------------
# Active Spring profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Spring Security basic auth (used for actuator or default user)
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Spring Boot - Database
# ------------------------------------------------------------------------------
# JDBC URL for PostgreSQL connection
# When running via docker-compose, the host is "db" (the service name).
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/research-repo-db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Application - Google OAuth
# ------------------------------------------------------------------------------
# Google OAuth 2.0 credentials for social login.
# Create credentials at: https://console.cloud.google.com/apis/credentials
APP_GOOGLE_CLIENT_ID=your-google-client-id
APP_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Application - JWT & Tokens
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (use a strong random string).
APP_JWT_SECRET=your-jwt-secret-key-change-this-to-a-strong-random-string

# Access token expiry in seconds (default: 3600 = 1 hour)
APP_JWT_ACCESS_TOKEN_EXPIRY=3600

# Refresh token cookie name (default: refreshToken)
APP_REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Refresh token max age in seconds (default: 2592000 = 30 days)
APP_REFRESH_TOKEN_MAX_AGE=2592000

# ------------------------------------------------------------------------------
# Application - CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated list of allowed HTTP methods.
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Allowed headers (use * for all).
APP_CORS_ALLOWED_HEADERS=*

# Whether to allow credentials (cookies/auth headers) in CORS requests.
APP_CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# Docker Volume Paths
# ------------------------------------------------------------------------------
# Absolute host paths for Docker volume mounts.
# Adjust these to match your local machine's directory structure.

# Path to the privileged-users YAML config file.
PRIVILEGED_USERS_CONFIG_HOST_PATH=/home/user/research-repository/backend/src/main/resources/config/privileged-users.yaml

# ------------------------------------------------------------------------------
# Storage Provider (local | minio)
# ------------------------------------------------------------------------------
# Use "local" for filesystem storage, "minio" for S3-compatible object storage.
APP_STORAGE_PROVIDER=local

# ------------------------------------------------------------------------------
# MinIO (S3-compatible storage) - only needed when APP_STORAGE_PROVIDER=minio
# ------------------------------------------------------------------------------
# MinIO server endpoint (Docker service name when using docker-compose).
APP_MINIO_ENDPOINT=http://minio:9000
# MinIO root credentials.
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
# MinIO bucket name for storing research paper files.
APP_MINIO_BUCKET=research-papers
# Whether to use HTTPS for MinIO connections.
APP_MINIO_SECURE=false
