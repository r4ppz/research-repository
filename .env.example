# ==============================================================================
# Production environment template
# Copy to .env in the project root for production:
#   cp .env.example .env
#
# Used by: docker-compose.yml (make up ENV=prod)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=research-repo-db
POSTGRES_USER=research_repo
POSTGRES_PASSWORD=changeme

SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/research-repo-db
SPRING_DATASOURCE_USERNAME=research_repo
SPRING_DATASOURCE_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Spring Security
# ------------------------------------------------------------------------------
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Spring Profiles
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
APP_GOOGLE_CLIENT_ID=your-google-client-id
APP_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# JWT & Tokens
# ------------------------------------------------------------------------------
APP_JWT_SECRET=change-this-to-a-strong-random-secret
APP_JWT_ACCESS_TOKEN_EXPIRY=3600
APP_REFRESH_TOKEN_COOKIE_NAME=refreshToken
APP_REFRESH_TOKEN_MAX_AGE=2592000

# Email of the initial super admin (only used on first login)
INITIAL_SUPER_ADMIN_EMAIL=

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=https://researchrepo.r4ppz.dev
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# Storage (MinIO)
# ------------------------------------------------------------------------------
APP_STORAGE_PROVIDER=minio
APP_MINIO_ENDPOINT=http://minio:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=research-papers
APP_MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Frontend build args (used by docker compose at build time)
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_BACKEND_API_BASE_URL=http://localhost:8080
